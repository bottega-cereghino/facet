{
  "max": 6,
  "per_repo": 2,
  "hold": "facet-queue.hold",
  "gate": ["gate", "{repo}", "{number}", "{labels}"],
  "wait": "30s",
  "label": "next",
  "priorities": "priorities.example.txt",
  "repos": ["acme/widgets", "acme/other"],
  "prompt": "Do each issue below, in order. The workspace is {workspace}. {issues} Do the work each issue describes. Merge when the checks are green. Comment the result on the issue. Remove the {label} label when the issue is done. Then exit.",
  "effort": {
    "default": "medium",
    "labels": {
      "chore": "low",
      "fix": "low",
      "deps": "low",
      "feat": "medium",
      "design": "medium"
    }
  },
  "state": "facet-queue.state.json",
  "heartbeat": "facet-queue.heartbeat.json",
  "fix": {
    "command": ["agent", "--effort", "{effort}", "{prompt}"],
    "prompt": "Pull request #{pr} on {branch} in {repo} is {reason}. This is try {try}. The workspace is {workspace}. Make CI green on the same branch. If it conflicts, merge origin/{base} into it. Never weaken a test without the repository's own rule for that. Push, then exit.",
    "gate": ["fix-gate", "{repo}", "{number}", "{pr}"],
    "tries": 2,
    "blockLabel": "blocked",
    "notify": ["notify", "{repo}#{number} PR #{pr}: {reason}"],
    "land": true
  },
  "lanes": {
    "command": ["lanes", "--json"],
    "log": "runs.jsonl"
  },
  "serialize": {
    "paths": ["**/*baseline*", "**/config.json", "**/*.lock", "package-lock.json", "go.sum"]
  },
  "agents": [
    {
      "label": "codex",
      "bundle": 1,
      "command": ["agent", "--for", "codex", "--effort", "{effort}", "{prompt}"]
    },
    {
      "label": "gemini",
      "command": ["agent", "--for", "gemini", "--effort", "{effort}", "{prompt}"]
    },
    {
      "label": "",
      "command": ["agent", "--effort", "{effort}", "{prompt}"]
    }
  ]
}
